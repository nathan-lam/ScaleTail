# ==========================================
# 1. Global Settings & Snippets
# ==========================================

{
    # Global email for ACME registration
    email your-email@example.com
}

# Global Wildcard TLS definition for all subdomains
*.69483840.xyz, 69483840.xyz {
    tls {
        issuer acme {
            dns porkbun {
                api_key {env.PORKBUN_API_KEY}
                api_secret_key {env.PORKBUN_SECRET_KEY}
            }
        }
    }
}

# Reusable proxy headers for standard web apps
(standard_proxy) {
    header_up Host {host}
    header_up X-Real-IP {remote_host}
    header_up X-Forwarded-For {remote_host}
    header_up X-Forwarded-Proto {scheme}
}

# Reusable proxy headers for apps that need WebSockets (terminals, stats)
(websocket_proxy) {
    import standard_proxy
    header_up Upgrade {http.request.header.Upgrade}
    header_up Connection {http.request.header.Connection}
}


# ==========================================
# 2. Service Blocks
# ==========================================

calagopus.69483840.xyz {
    reverse_proxy 172.17.0.1:8000 {
        import websocket_proxy
    }
    request_body {
        max_size 100MB
    }
}

copyparty.69483840.xyz {
    reverse_proxy copyparty:3923 {
        import standard_proxy
    }
}

crafty.69483840.xyz {
    reverse_proxy https://crafty:8443 {
        transport http {
            tls_insecure_skip_verify
        }
        import websocket_proxy
        header_up X-Forwarded-Proto https
    }
}

